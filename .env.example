# ============================================================
# Contoh konfigurasi environment. Salin ke .env untuk development.
# JANGAN commit file .env yang berisi secret asli.
# ============================================================

# --- Supabase (dipakai di client, aman karena anon key) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# AI Chat
# ============================================================

# --- DEVELOPMENT (npm run dev) ---
# Client memanggil lewat proxy Vite (/ai-api) untuk hindari CORS.
VITE_AI_BASE_URL=/ai-api/v1
# Target asli server AI, dipakai proxy Vite (lihat vite.config.js).
VITE_AI_PROXY_TARGET=http://79.137.75.106:20128
VITE_AI_API_KEY=your-ai-api-key
VITE_AI_MODEL=gc/gemini-3-flash-preview

# ============================================================
# PRODUCTION (Vercel) — set di dashboard Vercel, BUKAN di file ini.
# Variabel ini dipakai oleh serverless function api/ai.js dan
# TIDAK terekspos ke browser (tanpa prefix VITE_).
#   AI_PROXY_TARGET=http://79.137.75.106:20128
#   AI_API_KEY=your-ai-api-key
#   AI_MODEL=gc/gemini-3-flash-preview
# Supabase juga tetap perlu di-set di Vercel:
#   VITE_SUPABASE_URL=...
#   VITE_SUPABASE_ANON_KEY=...
# ============================================================
