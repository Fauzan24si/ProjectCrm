# ============================================================
# Contoh konfigurasi environment. Salin ke .env untuk development.
# JANGAN commit file .env yang berisi secret asli.
# ============================================================

# --- Supabase (dipakai di client, aman karena anon key) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# AI Chat
# ============================================================

# --- DEVELOPMENT (npm run dev) ---
# Client memanggil lewat proxy Vite (/ai-api) untuk hindari CORS.
VITE_AI_BASE_URL=/ai-api/v1
# Target asli server AI, dipakai proxy Vite (lihat vite.config.js).
VITE_AI_PROXY_TARGET=http://79.137.75.106:20128
VITE_AI_API_KEY=your-ai-api-key
VITE_AI_MODEL=gc/gemini-3-flash-preview

# ============================================================
# PRODUCTION (Vercel) — set di dashboard Vercel, BUKAN di file ini.
# Variabel ini dipakai oleh serverless function api/ai.js dan
# TIDAK terekspos ke browser (tanpa prefix VITE_).
#   AI_PROXY_TARGET=http://79.137.75.106:20128
#   AI_API_KEY=your-ai-api-key
#   AI_MODEL=gc/gemini-3-flash-preview
# Supabase juga tetap perlu di-set di Vercel:
#   VITE_SUPABASE_URL=...
#   VITE_SUPABASE_ANON_KEY=...
# ============================================================

# ============================================================
# Midtrans Payment Gateway (Snap)
# ============================================================
# Ambil dari dashboard Midtrans: Settings > Access Keys (pakai Sandbox dulu).
# Client Key boleh publik (dipakai di browser).
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# Server Key RAHASIA — set di .env (dev) dan di Vercel (prod), TANPA prefix VITE_.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
# 'true' = production, 'false' = sandbox.
MIDTRANS_IS_PRODUCTION=false
VITE_MIDTRANS_IS_PRODUCTION=false

# ============================================================
# Resend (Email OTP saat registrasi)
# ============================================================
# Dipakai serverless api/auth/send-otp.js & verify-otp.js (TANPA prefix VITE_).
# Ambil API key dari https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Alamat pengirim. Untuk uji coba boleh pakai domain sandbox Resend:
#   FurniCRM <onboarding@resend.dev>
# Untuk produksi, pakai domain yang sudah diverifikasi di Resend.
# Diterima: RESEND_FROM atau EMAIL_FROM (keduanya dibaca).
RESEND_FROM=FurniCRM <onboarding@resend.dev>
# EMAIL_FROM="Afsphere <noreply@afpedia.site>"
